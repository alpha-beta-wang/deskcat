{
  "name": "mochi-desktop-pet",
  "version": "0.1.0",
  "description": "Mochi, a quiet photo-real desktop pet",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "dist": "electron-packager . Mochi --overwrite --out=dist --app-version=0.1.0",
    "dist:win": "electron-packager . Mochi --overwrite --out=dist --platform=win32 --arch=x64 --app-version=0.1.0",
    "dist:mac": "electron-packager . Mochi --overwrite --out=dist --platform=darwin --arch=arm64 --app-version=0.1.0"
    ,"dist:native:win": "dotnet publish native/windows/Mochi.Native.csproj -c Release -o dist/Mochi.Native-win-x64"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^31.0.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
